# oauth2-proxy config example — copy to oauth2-proxy.cfg and fill in secrets
# oauth2-proxy.cfg is gitignored (contains client_secret + cookie_secret)

provider = "oidc"
oidc_issuer_url = "http://10.200.0.125"
insecure_oidc_allow_unverified_email = true
skip_oidc_discovery = false

client_id = "REPLACE_WITH_CLIENT_ID"
client_secret = "REPLACE_WITH_CLIENT_SECRET"

redirect_url = "https://onemcp.inet.vn/oauth2/callback"

cookie_secret = "REPLACE_WITH_COOKIE_SECRET_32B_BASE64"
cookie_domains = ["onemcp.inet.vn"]
cookie_secure = true
cookie_httponly = true
cookie_samesite = "lax"
cookie_expire = "168h"

email_domains = ["*"]
skip_provider_button = true
set_xauthrequest = true
pass_access_token = true
pass_authorization_header = true
reverse_proxy = true

http_address = "0.0.0.0:4180"
whitelist_domains = ["onemcp.inet.vn"]

scope = "openid profile email offline_access"
