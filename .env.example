# =========================================
# OneMCP v1 — Environment Configuration
# Copy to .env and edit before docker compose up
# =========================================

# --- Postgres ---
POSTGRES_DB=onemcp
POSTGRES_USER=onemcp
POSTGRES_PASSWORD=change-me-use-hex-only-no-special-chars

# Postgres tuning (staging: 512MB/2GB/8MB/100; production: 4GB/12GB/32MB/200)
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE=2GB
PG_WORK_MEM=8MB
PG_MAX_CONNECTIONS=100

# --- MinIO ---
MINIO_ROOT_USER=onemcp
MINIO_ROOT_PASSWORD=change-me-min-8-chars
MINIO_BUCKET=onemcp-artifacts
ATTACHMENT_MAX_MB=100

# --- Access Control ---
# DEPRECATED: USER_ALLOW_CIDR / ADMIN_ALLOW_CIDR no longer enforced post-pivot 2026-07-27.
# Kept for rollback compatibility only — safe to leave empty.
USER_ALLOW_CIDR=
ADMIN_ALLOW_CIDR=
# DEPRECATED: TRUSTED_PROXY_CIDR no longer used for role gating post-pivot.
TRUSTED_PROXY_CIDR=127.0.0.1/32
# Trust header carrying claimed username (legacy bridge path)
TRUST_USER_HEADER=X-Onemcp-User
# Default role assigned to new users
DEFAULT_ROLE=contributor
# Bootstrap role lists (comma-separated usernames). Used by both trust-header + SSO modes.
MAINTAINER_USERNAMES=
ADMIN_USERNAMES=admin

# --- Emergency Kill Switch ---
# Set to true to reject all requests with 503 (except /health)
EMERGENCY_LOCKDOWN=false

# --- Auth Mode (SSO pivot 2026-07-27) ---
# 'trust-header' = legacy v1 behavior (safe default / rollback path).
# 'gitlab-sso'   = GitLab OAuth2 + Redis session cookie (post-pivot production mode).
AUTH_MODE=trust-header

# --- GitLab OAuth2 SSO (required only when AUTH_MODE=gitlab-sso) ---
# GitLab instance base URL (no trailing slash).
GITLAB_SSO_BASE_URL=https://gitlab.inet.vn
# OAuth Application ID from GitLab Admin > Applications.
# Register with: Redirect URI = https://202.92.5.113/api/auth/gitlab/callback
#                Scopes = read_user, Confidential = yes
GITLAB_OAUTH_APP_ID=
# OAuth Application Secret — treat as password, never commit real value.
GITLAB_OAUTH_APP_SECRET=
# Must match redirect URI registered in GitLab exactly.
GITLAB_OAUTH_REDIRECT_URI=https://202.92.5.113/api/auth/gitlab/callback

# --- Session Cookie ---
# Cookie name sent to browser. Change only if collision with other cookies.
SESSION_COOKIE_NAME=onemcp_session
# Session TTL in seconds (default 86400 = 24h). Sliding: resets on each authenticated request.
SESSION_TTL_SECONDS=86400
# OAuth state nonce TTL in seconds (default 300 = 5 min). Consumed on use (replay-safe).
OAUTH_STATE_TTL_SECONDS=300

# --- Public URLs ---
PUBLIC_API_URL=http://localhost/api

# --- GitLab (P2) ---
# GITLAB_BASE_URL rỗng = disable webhook processing + cron resync.
# Fill với https://gitlab.internal khi ready.
GITLAB_BASE_URL=
GITLAB_WEBHOOK_SECRET=change-me-webhook-hmac
# Deploy token (read_repository scope) — fetch skills mono-repo qua HTTPS.
GITLAB_MIRROR_TOKEN=
# Skills mono-repo layout: <namespace>/skills-<dept>. Path phần path_with_namespace.
SKILLS_MONO_REPO=onemcp/skills-kythuat
SKILLS_MONO_BRANCH=main
# Cron fallback resync (crontab format). Rỗng = disable.
SKILL_SYNC_CRON=*/15 * * * *
# Rate limit per IP cho approve action (req/min).
SKILL_APPROVE_RATE_LIMIT=20

# --- Embedding (Phase 2) ---
# TEI container internal URL — backend uses this to call text-embeddings-inference
EMBEDDING_URL=http://tei:80
EMBEDDING_DIM=384

# --- Observability (P6) ---
LOG_LEVEL=info
PROMETHEUS_ENABLED=true

# --- Backup (P6) ---
# Cron format for backup service. Default 03:00 UTC daily.
BACKUP_CRON=0 3 * * *
BACKUP_RETAIN_DAYS=14

# --- Ops Incident Response (P7) ---
# Feature flag: gate new artifact types (postmortem, runbook). Set 1 to enable.
ONEMCP_ENABLE_OPS_TYPES=0
# Known services list for search boost auto-detect (comma-separated, lowercase, no spaces).
ONEMCP_KNOWN_SERVICES=postgres,redis,nginx,minio,backend,portal,gitlab
# Alertmanager webhook Bearer token (rotate quarterly). Fill trước khi enable P7.
ALERTMANAGER_WEBHOOK_TOKEN=
# Slack incoming webhook URL cho #kythuat-oncall. Treat as secret.
SLACK_ONCALL_WEBHOOK_URL=
# Runbook load-events retention (days). Older rows purged by cron.
RUNBOOK_EVENTS_RETAIN_DAYS=90
# System user identity cho Alertmanager webhook search (regex-safe, no colons).
ALERTMANAGER_SYSTEM_USER=system-alertmanager
# Alertmanager dedup TTL in minutes (default 240 = 4h, aligned with Alertmanager repeat_interval).
ALERTMANAGER_DEDUP_TTL_MIN=240
